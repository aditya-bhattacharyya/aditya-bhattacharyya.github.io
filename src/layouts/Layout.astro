---
import BetterIcon from '../components/ui/BetterIcon.astro'
import DarkLightController from '../components/ui/DarkLightController.astro'
import Navbar from '../components/ui/Navbar.astro'
import Head from '../components/Head.astro'
import { seo, profile, template } from '../settings'
import Footer from '../components/ui/Footer.astro'

type Props = {
  title?: string
  description?: string
  image?: string
}

const {
  title = seo.default_title,
  description = seo.default_description,
  image = seo.default_image,
} = Astro.props
---

<!doctype html>
<html lang='en'>

  <head>

    <Head
      title={title}
      description={description}
      image={image}
    />

  </head>

  <body>

    <div class='site-layout'>

      <!-- ========================================================= -->
      <!-- MOBILE MENU TOGGLE                                        -->
      <!-- ========================================================= -->

      <input
        id='mobile-menu'
        type='checkbox'
        class='mobile-menu-toggle'
      />


      <!-- ========================================================= -->
      <!-- MOBILE MENU OVERLAY                                       -->
      <!-- ========================================================= -->

      <label
        for='mobile-menu'
        class='mobile-menu-overlay'
        aria-label='Close navigation menu'
      ></label>


      <!-- ========================================================= -->
      <!-- SIDEBAR                                                   -->
      <!-- ========================================================= -->

      <aside class='site-sidebar'>

        <Navbar />

      </aside>


      <!-- ========================================================= -->
      <!-- MAIN AREA                                                 -->
      <!-- ========================================================= -->

      <div class='site-main'>

        <!-- ======================================================= -->
        <!-- TOP NAVIGATION                                           -->
        <!-- ======================================================= -->

        <header class='site-header'>

          <nav class='mobile-navbar'>

            <!-- LEFT SIDE -->

            <div class='mobile-navbar-left'>

              <!-- Mobile hamburger menu -->

              <label
                for='mobile-menu'
                class='mobile-menu-button'
                aria-label='Open navigation menu'
              >

                <BetterIcon>

                  <svg
                    xmlns='http://www.w3.org/2000/svg'
                    fill='none'
                    viewBox='0 0 24 24'
                    stroke-width='1.5'
                    class='size-6 stroke-current'
                  >

                    <path
                      stroke-linecap='round'
                      stroke-linejoin='round'
                      d='M3.75 6.75h16.5M3.75 12h16.5m-16.5 5.25h16.5'
                    ></path>

                  </svg>

                </BetterIcon>

              </label>

            </div>


            <!-- MOBILE TITLE -->

            <div class='mobile-navbar-title'>

              {profile.fullName}

            </div>


            <!-- MOBILE DARK / LIGHT SWITCH -->

            <div class='mobile-navbar-right'>

              <DarkLightController />

            </div>

          </nav>


          <!-- ===================================================== -->
          <!-- DESKTOP DARK / LIGHT SWITCH                           -->
          <!-- ===================================================== -->

          <div class='desktop-theme-controller'>

            <DarkLightController />

          </div>

        </header>


        <!-- ======================================================= -->
        <!-- PAGE CONTENT                                             -->
        <!-- ======================================================= -->

        <main class='page-content'>

          <slot />

          <Footer />

        </main>

      </div>

    </div>

  </body>

</html>


<style>
  /* ============================================================= */
  /* BASIC PAGE SETUP                                              */
  /* ============================================================= */

  html,
  body {
    margin: 0;
    width: 100%;
    min-height: 100%;
  }

  body {
    overflow-x: hidden;
  }


  /* ============================================================= */
  /* MAIN SITE LAYOUT                                               */
  /* ============================================================= */

  .site-layout {
    width: 100%;
    min-height: 100vh;

    display: flex;

    background: hsl(var(--b1));
    color: hsl(var(--bc));
  }


  /* ============================================================= */
  /* HIDDEN MOBILE CHECKBOX                                        */
  /* ============================================================= */

  .mobile-menu-toggle {
    position: fixed;

    width: 1px;
    height: 1px;

    opacity: 0;

    pointer-events: none;
  }


  /* ============================================================= */
  /* SIDEBAR                                                        */
  /* ============================================================= */

  .site-sidebar {
    width: 320px;
    min-width: 320px;
    max-width: 320px;

    height: 100vh;
    min-height: 100vh;

    flex-shrink: 0;

    position: sticky;
    top: 0;

    align-self: flex-start;
  }


  /* ============================================================= */
  /* MAIN CONTENT AREA                                              */
  /* ============================================================= */

  .site-main {
    min-width: 0;

    flex: 1 1 auto;

    min-height: 100vh;

    background: hsl(var(--b1));
  }


  /* ============================================================= */
  /* HEADER                                                          */
  /* ============================================================= */

  .site-header {
    position: relative;

    width: 100%;

    background: hsl(var(--b1));
    color: hsl(var(--bc));

    box-shadow: 0 1px 3px rgb(0 0 0 / 0.08);
  }


  /* ============================================================= */
  /* MOBILE NAVBAR                                                   */
  /* ============================================================= */

  .mobile-navbar {
    display: none;

    width: 100%;
    min-height: 4rem;

    align-items: center;
    justify-content: space-between;

    padding: 0 1rem;

    gap: 0.5rem;

    box-sizing: border-box;
  }


  .mobile-navbar-left,
  .mobile-navbar-right {
    display: flex;

    align-items: center;

    flex-shrink: 0;
  }


  .mobile-navbar-title {
    min-width: 0;

    flex: 1 1 auto;

    text-align: center;

    font-size: 1rem;
    font-weight: 700;

    white-space: nowrap;

    overflow: hidden;

    text-overflow: ellipsis;
  }


  /* ============================================================= */
  /* MOBILE HAMBURGER                                               */
  /* ============================================================= */

  .mobile-menu-button {
    width: 2.75rem;
    height: 2.75rem;

    display: inline-flex;

    align-items: center;
    justify-content: center;

    cursor: pointer;

    border-radius: 0.5rem;

    background: hsl(var(--b2));
    color: hsl(var(--bc));

    -webkit-tap-highlight-color: transparent;

    transition:
      background-color 0.15s ease,
      transform 0.1s ease;
  }


  .mobile-menu-button:hover {
    background: hsl(var(--b3));
  }


  .mobile-menu-button:active {
    background: hsl(var(--b3));

    transform: scale(0.96);
  }


  /* ============================================================= */
  /* DESKTOP THEME CONTROLLER                                      */
  /* ============================================================= */

  .desktop-theme-controller {
    position: absolute;

    top: 1rem;
    right: 1.5rem;

    z-index: 20;

    display: flex;

    align-items: center;
  }


  /* ============================================================= */
  /* MOBILE OVERLAY                                                  */
  /* ============================================================= */

  .mobile-menu-overlay {
    display: none;
  }


  /* ============================================================= */
  /* PAGE CONTENT                                                    */
  /* ============================================================= */

  .page-content {
    width: 100%;
    max-width: 64rem;

    min-height: 100vh;

    margin: 0 auto;

    padding: 4rem 2rem 2rem;

    display: flex;

    flex-direction: column;

    justify-content: space-between;

    box-sizing: border-box;
  }


  /* ============================================================= */
  /* MOBILE                                                          */
  /* ============================================================= */

  @media (max-width: 1023px) {

    .site-layout {
      display: block;

      min-height: 100vh;
    }


    /* ----------------------------------------------------------- */
    /* Mobile sidebar                                               */
    /* ----------------------------------------------------------- */

    .site-sidebar {
      position: fixed;

      z-index: 100;

      top: 0;
      left: 0;

      width: min(320px, 85vw);
      min-width: min(320px, 85vw);
      max-width: min(320px, 85vw);

      height: 100vh;
      min-height: 100vh;

      transform: translateX(-100%);

      transition: transform 0.25s ease;

      overflow-y: auto;
      overflow-x: hidden;

      -webkit-overflow-scrolling: touch;

      align-self: auto;
    }


    /* ----------------------------------------------------------- */
    /* Main area                                                    */
    /* ----------------------------------------------------------- */

    .site-main {
      width: 100%;

      min-width: 0;

      min-height: 100vh;
    }


    /* ----------------------------------------------------------- */
    /* Mobile header                                                */
    /* ----------------------------------------------------------- */

    .mobile-navbar {
      display: flex;
    }


    /* Hide desktop theme switch */

    .desktop-theme-controller {
      display: none;
    }


    /* ----------------------------------------------------------- */
    /* Mobile page content                                          */
    /* ----------------------------------------------------------- */

    .page-content {
      width: 100%;

      max-width: none;

      min-height: calc(100vh - 4rem);

      padding: 1.5rem 1rem;

      margin: 0;
    }


    /* ----------------------------------------------------------- */
    /* Mobile overlay                                               */
    /* ----------------------------------------------------------- */

    .mobile-menu-overlay {
      position: fixed;

      z-index: 90;

      inset: 0;

      display: block;

      background: rgb(0 0 0 / 0.45);

      opacity: 0;

      visibility: hidden;

      pointer-events: none;

      transition:
        opacity 0.25s ease,
        visibility 0.25s ease;
    }


    /* =========================================================== */
    /* MENU OPEN STATE                                             */
    /* =========================================================== */

    #mobile-menu:checked ~ .site-sidebar {
      transform: translateX(0);
    }


    #mobile-menu:checked ~ .mobile-menu-overlay {
      opacity: 1;

      visibility: visible;

      pointer-events: auto;
    }

  }


  /* ============================================================= */
  /* SMALL iPHONE SCREENS                                           */
  /* ============================================================= */

  @media (max-width: 480px) {

    .mobile-navbar {
      min-height: 3.75rem;

      padding-left: 0.5rem;
      padding-right: 0.5rem;
    }


    .mobile-navbar-title {
      font-size: 0.95rem;
    }


    .page-content {
      padding-left: 1rem;
      padding-right: 1rem;
    }

  }
</style>
