---
interface Props {
  title: string;
  subtitle: string;
}

const { title, subtitle } = Astro.props;
---

<div class="relative pl-6 border-l-2 border-base-300">
  <div class="absolute -left-[7px] top-1.5 w-3 h-3 rounded-full bg-primary"></div>

  <div class="mb-1 text-lg font-semibold">
    {title}
  </div>

  <div class="text-sm opacity-70">
    {subtitle}
  </div>

  <div class="mt-2 leading-relaxed">
    <slot />
  </div>
</div>
