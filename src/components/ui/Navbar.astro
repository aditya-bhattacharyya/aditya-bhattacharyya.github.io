---
import { Image } from 'astro:assets'
import { profile } from '../../settings'
import SocialIcons from './SocialIcons.astro'
import ProfilePictures from '@/assets/profile.png'
import { template } from '@/settings'

const { fullName, title } = profile
---

<aside
  class='px-4 pt-4 min-h-screen w-80 min-w-80 max-w-80 shrink-0 bg-base-200 text-base-content flex flex-col'
>
  <div class='flex flex-col my-8 justify-between h-full'>

    <div>

      <!-- ===================================================== -->
      <!-- PROFILE                                               -->
      <!-- ===================================================== -->

      <div class='flex justify-center items-center flex-col'>

        <Image
          class='mask mask-circle size-44 object-cover object-[50%_25%]'
          src={ProfilePictures}
          alt={`Profile picture of ${fullName}`}
        />


        <div class="mt-8 hidden lg:block text-center px-2">

          <div class="text-lg font-black leading-tight">
            {fullName}
          </div>


          <div class="text-sm font-medium opacity-60 mt-2">
            Associate Scientific Director
          </div>


          <div class="text-sm opacity-50 mt-1">
            BBRC, Syngene
          </div>

        </div>

      </div>


      <!-- ===================================================== -->
      <!-- NAVIGATION                                            -->
      <!-- ===================================================== -->

      <div class='mx-4 mt-16'>

        <ul class='space-y-4 menu grow shrink menu-md overflow-y-auto'>

          <li>

            <a
              href={`${template.base}/`}
              class='text-lg'
            >
              Home
            </a>

          </li>


          <li>

            <a
              href={`${template.base}/research`}
              class='text-lg'
            >
              Research
            </a>

          </li>


          <li>

            <a
              href={`${template.base}/papers`}
              class='text-lg'
            >
              Publications
            </a>

          </li>


          <li>

            <a
              href={`${template.base}/patents`}
              class='text-lg'
            >
              Patents
            </a>

          </li>


          <li>

            <a
              href={`${template.base}/talks`}
              class='text-lg'
            >
              Invited Talks
            </a>

          </li>


          <li>

            <a
              href={`${template.base}/cv`}
              class='text-lg'
            >
              CV
            </a>

          </li>

        </ul>

      </div>

    </div>


    <!-- ===================================================== -->
    <!-- SOCIAL LINKS                                          -->
    <!-- ===================================================== -->

    <div class='mx-4'>

      <SocialIcons/>

    </div>

  </div>

</aside>
