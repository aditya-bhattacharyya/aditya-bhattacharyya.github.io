---
import { template } from '../../settings'
---

<label
  class="theme-toggle"
  aria-label="Toggle dark and light mode"
>

  <input
    type="checkbox"
    value={template.darkTheme}
    class="theme-toggle-input"
    data-choose-theme
  />

  <!-- Sun icon -->

  <svg
    class="theme-icon"
    xmlns="http://www.w3.org/2000/svg"
    width="14"
    height="14"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >

    <circle cx="12" cy="12" r="5" />

    <path
      d="M12 1v2
         M12 21v2
         M4.2 4.2l1.4 1.4
         M18.4 18.4l1.4 1.4
         M1 12h2
         M21 12h2
         M4.2 19.8l1.4-1.4
         M18.4 5.6l1.4-1.4"
    />

  </svg>


  <!-- Moon icon -->

  <svg
    class="theme-icon"
    xmlns="http://www.w3.org/2000/svg"
    width="14"
    height="14"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >

    <path
      d="M21 12.79A9 9 0 1 1 11.21 3
         7 7 0 0 0 21 12.79z"
    />

  </svg>

</label>


<style>
  /* ============================================================= */
  /* THEME TOGGLE                                                   */
  /* ============================================================= */

  .theme-toggle {
    display: grid;
    place-items: center;

    position: relative;

    width: 3rem;
    height: 1.5rem;

    cursor: pointer;

    border-radius: 9999px;

    background: hsl(var(--bc) / 0.15);

    flex-shrink: 0;

    -webkit-tap-highlight-color: transparent;
  }


  /* ============================================================= */
  /* HIDDEN CHECKBOX                                                */
  /* ============================================================= */

  .theme-toggle-input {
    appearance: none;
    -webkit-appearance: none;

    position: absolute;

    inset: 0;

    width: 100%;
    height: 100%;

    margin: 0;

    cursor: pointer;

    opacity: 0;

    z-index: 3;
  }


  /* ============================================================= */
  /* ICONS                                                          */
  /* ============================================================= */

  .theme-icon {
    position: absolute;

    top: 50%;

    width: 14px;
    height: 14px;

    transform: translateY(-50%);

    color: hsl(var(--b1));

    pointer-events: none;

    z-index: 2;
  }


  .theme-icon:first-of-type {
    left: 5px;
  }


  .theme-icon:last-of-type {
    right: 5px;
  }


  /* ============================================================= */
  /* FOCUS                                                         */
  /* ============================================================= */

  .theme-toggle-input:focus-visible {
    outline: 2px solid hsl(var(--p));
    outline-offset: 3px;
    border-radius: 9999px;
  }
</style>
