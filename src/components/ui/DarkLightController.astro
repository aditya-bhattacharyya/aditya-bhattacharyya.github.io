---
import { template } from '../../settings'
---

<label
  class="theme-toggle"
  aria-label="Toggle dark and light mode"
>

  <input
    id="theme-toggle"
    type="checkbox"
    class="theme-toggle-input"
    aria-label="Toggle dark and light mode"
  />


  <!-- Sun -->

  <svg
    class="theme-icon theme-sun"
    xmlns="http://www.w3.org/2000/svg"
    width="14"
    height="14"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >

    <circle cx="12" cy="12" r="5" />

    <path
      d="M12 1v2
         M12 21v2
         M4.2 4.2l1.4 1.4
         M18.4 18.4l1.4 1.4
         M1 12h2
         M21 12h2
         M4.2 19.8l1.4-1.4
         M18.4 5.6l1.4-1.4"
    />

  </svg>


  <!-- Moon -->

  <svg
    class="theme-icon theme-moon"
    xmlns="http://www.w3.org/2000/svg"
    width="14"
    height="14"
    viewBox="0 0 24 24"
    fill="none"
    stroke="currentColor"
    stroke-width="2"
    stroke-linecap="round"
    stroke-linejoin="round"
    aria-hidden="true"
  >

    <path
      d="M21 12.79A9 9 0 1 1 11.21 3
         7 7 0 0 0 21 12.79z"
    />

  </svg>


  <!-- Sliding knob -->

  <span class="theme-toggle-knob"></span>

</label>


<script>
  const initializeThemeToggle = () => {

    const toggles =
      document.querySelectorAll<HTMLInputElement>('.theme-toggle-input')

    if (!toggles.length) return


    const currentTheme =
      document.documentElement.getAttribute('data-theme') ||
      localStorage.getItem('theme') ||
      'light'


    document.documentElement.setAttribute(
      'data-theme',
      currentTheme
    )


    toggles.forEach((toggle) => {

      toggle.checked = currentTheme === 'dark'


      toggle.onchange = () => {

        const newTheme =
          toggle.checked ? 'dark' : 'light'


        document.documentElement.setAttribute(
          'data-theme',
          newTheme
        )


        localStorage.setItem(
          'theme',
          newTheme
        )


        toggles.forEach((otherToggle) => {

          otherToggle.checked =
            toggle.checked

        })

      }

    })

  }


  initializeThemeToggle()
</script>


<style>
  /* ============================================================= */
  /* TOGGLE                                                         */
  /* ============================================================= */

  .theme-toggle {
    position: relative;

    display: block;

    width: 3.25rem;
    height: 1.75rem;

    border-radius: 9999px;

    cursor: pointer;

    background: hsl(var(--bc) / 0.18);

    flex-shrink: 0;

    -webkit-tap-highlight-color: transparent;
  }


  /* ============================================================= */
  /* CHECKBOX                                                        */
  /* ============================================================= */

  .theme-toggle-input {
    position: absolute;

    inset: 0;

    width: 100%;
    height: 100%;

    margin: 0;

    opacity: 0;

    cursor: pointer;

    z-index: 5;
  }


  /* ============================================================= */
  /* SLIDING KNOB                                                   */
  /* ============================================================= */

  .theme-toggle-knob {
    position: absolute;

    top: 3px;
    left: 3px;

    width: 1.25rem;
    height: 1.25rem;

    border-radius: 50%;

    background: hsl(var(--b1));

    box-shadow: 0 1px 3px rgb(0 0 0 / 0.25);

    transition: transform 0.2s ease;

    pointer-events: none;

    z-index: 2;
  }


  /* ============================================================= */
  /* ICONS                                                          */
  /* ============================================================= */

  .theme-icon {
    position: absolute;

    top: 50%;

    width: 12px;
    height: 12px;

    transform: translateY(-50%);

    color: hsl(var(--bc));

    pointer-events: none;

    z-index: 3;
  }


  .theme-sun {
    left: 6px;
  }


  .theme-moon {
    right: 6px;
  }


  /* ============================================================= */
  /* DARK MODE POSITION                                             */
  /* ============================================================= */

  .theme-toggle-input:checked
    ~ .theme-toggle-knob {
    transform: translateX(1.5rem);
  }


  /* ============================================================= */
  /* FOCUS                                                          */
  /* ============================================================= */

  .theme-toggle-input:focus-visible {
    outline: 2px solid hsl(var(--p));
    outline-offset: 3px;
    border-radius: 9999px;
  }
</style>
