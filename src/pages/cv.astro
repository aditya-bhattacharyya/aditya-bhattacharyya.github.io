---
import BaseLayout from "../layouts/Layout.astro";
---

<BaseLayout title="CV | Dr. Aditya Bhattacharyya" sideBarActiveItemID="cv">

  <!-- Header -->
  <div class="mb-8">
    <div class="text-3xl w-full font-bold">
      Dr. Aditya Bhattacharyya
    </div>

    <div class="text-xl font-medium mt-1">
      Associate Scientific Director | Chemical Synthesis
    </div>

    <div class="text-sm opacity-70 mt-1">
      Biocon Bristol Myers Squibb R&D Center (BBRC), Syngene International Ltd.
    </div>
  </div>

  <!-- Download CV -->
  <div class="mb-10">
    <a
      href="/Bhattacharyya_CV.pdf"
      target="_blank"
      class="btn btn-primary"
    >
      📄 Download PDF CV
    </a>
  </div>

  <!-- Executive Summary -->
  <div class="mb-10">
    <div class="text-2xl w-full font-bold mb-3">
      Executive Summary
    </div>

    <p class="text-justify leading-relaxed">
      Organic &amp; Synthetic Chemist with 6+ years of postdoctoral research
      experience across Germany and India, combined with 3+ years of
      pharmaceutical CRO technical leadership. Marie Skłodowska-Curie
      Individual Fellow (Score: 95.60%) with 37 peer-reviewed publications,
      2 granted patents, and &gt;1,800 citations. Specialized in photoredox
      catalysis, visible-light-driven transformations, and complex small-ring
      heterocycle synthesis for drug discovery.
    </p>
  </div>

  <!-- Professional Experience -->
  <div class="mb-5">
    <div class="text-2xl w-full font-bold">
      Professional Experience
    </div>
  </div>

  <div class="grid gap-4 mb-10">

    <div class="card bg-base-200">
      <div class="card-body">
        <h3 class="card-title text-lg">
          Associate Scientific Director
        </h3>
        <p class="text-sm opacity-70">
          Aug 2026 – Present · Department of Chemical Synthesis, BBRC,
          Syngene International Ltd., India
        </p>
      </div>
    </div>

    <div class="card bg-base-200">
      <div class="card-body">
        <h3 class="card-title text-lg">
          Principal Investigator (Team Lead)
        </h3>
        <p class="text-sm opacity-70">
          Oct 2024 – Jul 2026 · Department of Chemical Synthesis, BBRC,
          Syngene International Ltd., India
        </p>
      </div>
    </div>

    <div class="card bg-base-200">
      <div class="card-body">
        <h3 class="card-title text-lg">
          Senior Research Investigator (Team Lead)
        </h3>
        <p class="text-sm opacity-70">
          Oct 2022 – Sep 2024 · Department of Discovery Synthesis, BBRC,
          Syngene International Ltd., India
        </p>
      </div>
    </div>

    <div class="card bg-base-200">
      <div class="card-body">
        <h3 class="card-title text-lg">
          Postdoctoral Researcher &amp; Marie Curie Fellow
        </h3>
        <p class="text-sm opacity-70">
          Apr 2018 – Sep 2022 · Universität Regensburg, Germany
          (Advisor: Prof. Dr. Oliver Reiser)
        </p>

        <p class="mt-2 text-sm leading-relaxed">
          Research focus: Copper photoredox-catalyzed ring-opening
          transformations of small ring aza-heterocycles and carbacycles.
        </p>
      </div>
    </div>

    <div class="card bg-base-200">
      <div class="card-body">
        <h3 class="card-title text-lg">
          CSIR Research Associate &amp; DST Project Scientist
        </h3>
        <p class="text-sm opacity-70">
          Jun 2016 – Mar 2018 · IIT Kanpur, India
          (Advisor: Prof. Manas K. Ghorai)
        </p>
      </div>
    </div>

  </div>

  <!-- Education -->
  <div class="mb-5">
    <div class="text-2xl w-full font-bold">
      Education
    </div>
  </div>

  <div class="grid gap-4 mb-10">

    <div class="card bg-base-200">
      <div class="card-body">
        <h3 class="card-title text-lg">
          Ph.D. in Organic Chemistry
        </h3>

        <p class="text-sm opacity-70">
          2016 · Indian Institute of Technology (IIT) Kanpur, India
        </p>

        <p class="mt-2 text-sm leading-relaxed">
          Thesis: Ring-Opening Transformations of Activated Aziridines to
          Iminothiazolidines, Tetrahydropyrimidines, Oxime Amino Ethers,
          and Morpholines.
        </p>
      </div>
    </div>

    <div class="card bg-base-200">
      <div class="card-body">
        <h3 class="card-title text-lg">
          M.Sc. in Organic Chemistry
        </h3>

        <p class="text-sm opacity-70">
          2008 · Bengal Engineering and Science University (IIEST Shibpur), India
        </p>

        <p class="mt-2 text-sm">
          Rank: First Class First (University Silver Medalist)
        </p>
      </div>
    </div>

    <div class="card bg-base-200">
      <div class="card-body">
        <h3 class="card-title text-lg">
          B.Sc. (Honours) in Chemistry
        </h3>

        <p class="text-sm opacity-70">
          2006 · Bangabasi College, University of Calcutta, India
        </p>
      </div>
    </div>

  </div>

  <!-- Honors & Grants -->
  <div class="mb-5">
    <div class="text-2xl w-full font-bold">
      Honors &amp; Grants
    </div>
  </div>

  <ul class="list-disc mx-6 mb-10 space-y-2">
    <li>
      <strong>Biocon-BMS Spot &amp; Bravo Awards</strong>
      for productivity in BMS project execution &amp; publication (2023–2026)
    </li>

    <li>
      <strong>Marie Skłodowska-Curie Individual Fellowship</strong>
      European Union Horizon 2020 (2018–2020)
    </li>

    <li>
      <strong>CAS Registry® Innovator Certificate</strong>
      for novel chemical substance innovations (2023)
    </li>

    <li>
      <strong>GATE Examination:</strong>
      Score 504, Percentile 98.43, All India Rank 102 (2008)
    </li>

    <li>
      <strong>CSIR-UGC NET:</strong>
      Qualified National Eligibility Test in Chemical Sciences (2007, 2008)
    </li>
  </ul>

  <!-- Professional Service & Memberships -->
  <div class="mb-5">
    <div class="text-2xl w-full font-bold">
      Professional Service &amp; Memberships
    </div>
  </div>

  <ul class="list-disc mx-6 mb-10 space-y-2">

    <li>
      <strong>Journal Peer Reviewer:</strong>
      71 manuscripts for 23 journals (including
      <i>Angew. Chem. Int. Ed.</i>,
      <i>Org. Lett.</i>, and
      <i>J. Org. Chem.</i>)
    </li>

   <li>
      <strong>Memberships:</strong>
      Royal Society of Chemistry (MRSC), Fellow of Indian Chemical Society
      (FICS), Marie Curie Alumni Association
    </li>

  </ul>

</BaseLayout>
