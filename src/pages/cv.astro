---
import BaseLayout from "../layouts/Layout.astro";
import TimeLineElement from "../components/cv/TimeLineHeader.astro";
---

<BaseLayout title="CV | Dr. Aditya Bhattacharyya" sideBarActiveItemID="cv">

  <!-- Header -->
  <div class="mb-6">

    <div class="text-3xl w-full font-bold">
      Dr. Aditya Bhattacharyya
    </div>

    <div class="text-xl font-medium mt-1">
      Associate Scientific Director | Chemical Synthesis
    </div>

    <div class="text-sm opacity-70">
      Biocon Bristol Myers Squibb R&D Center (BBRC), Syngene International Ltd.
    </div>

  </div>


  <!-- PDF -->
  <div class="mb-10">

    <a
      href="/Bhattacharyya_CV.pdf"
      target="_blank"
      class="btn btn-primary"
    >
      📄 Download PDF CV
    </a>

  </div>


  <!-- Executive Summary -->
  <section class="mb-12">

    <div class="text-2xl w-full font-bold mb-3">
      Executive Summary
    </div>

    <p class="text-justify leading-relaxed">
      Organic & Synthetic Chemist with 6+ years of postdoctoral research
      experience across Germany and India, combined with 3+ years of
      pharmaceutical CRO technical leadership. Marie Skłodowska-Curie
      Individual Fellow with 33 peer-reviewed publications, 2 granted
      patents, and more than 1,800 citations. Specialized in photoredox
      catalysis, visible-light-driven transformations, and complex
      small-ring heterocycle synthesis for drug discovery.
    </p>

  </section>


  <!-- Professional Experience -->
  <section class="mb-12">

    <div class="text-2xl w-full font-bold mb-5">
      Professional Experience
    </div>

    <div class="time-line-container grid gap-4">

      <TimeLineElement
        title="Associate Scientific Director"
        subtitle="Aug 2026 – Present at BBRC, Syngene International Ltd., India"
      />

      <TimeLineElement
        title="Principal Investigator"
        subtitle="Oct 2024 – Jul 2026 at BBRC, Syngene International Ltd., India"
      />

      <TimeLineElement
        title="Senior Research Investigator"
        subtitle="Oct 2022 – Sep 2024 at BBRC, Syngene International Ltd., India"
      />

      <TimeLineElement
        title="Marie Skłodowska-Curie Fellow & Postdoctoral Researcher"
        subtitle="Apr 2018 – Sep 2022 at Universität Regensburg, Germany (Advisor: Prof. Dr. Oliver Reiser)"
      >
        Research focus: Visible-light-mediated copper photoredox-catalyzed
        ring-opening transformations of activated small-ring
        aza-heterocycles and carbacycles.
      </TimeLineElement>

      <TimeLineElement
        title="DST Project Scientist & CSIR Research Associate"
        subtitle="Jun 2016 – Mar 2018 at IIT Kanpur, India (Advisor: Prof. Manas K. Ghorai)"
      />

    </div>

  </section>


  <!-- Education -->
  <section class="mb-12">

    <div class="text-2xl w-full font-bold mb-5">
      Education
    </div>

    <div class="time-line-container grid gap-4">

      <TimeLineElement
        title="Ph.D. in Organic Chemistry"
        subtitle="2016 at Indian Institute of Technology (IIT) Kanpur, India"
      >
        Thesis: Ring-Opening Transformations of Activated Aziridines to
        Iminothiazolidines, Tetrahydropyrimidines, Oxime Amino Ethers,
        and Morpholines. First category from all four reviewers
      </TimeLineElement>

      <TimeLineElement
        title="M.Sc. in Organic Chemistry"
        subtitle="2008 at Bengal Engineering and Science University, Shibpur (presently IIEST), India"
      >
        <strong>First Class First; University Silver Medalist.</strong>
        <br />
        Thesis: A New Synthesis of Coniine: A Hemlock Alkaloid
      </TimeLineElement>

      <TimeLineElement
        title="B.Sc. (Hons.) in Chemistry"
        subtitle="2006 at Bangabasi College, University of Calcutta, India"
      />

    </div>

  </section>


  <!-- Awards, Fellowships & Distinctions -->
  <section class="mb-12">

    <div class="text-2xl w-full font-bold mb-5">
      Awards, Fellowships & Distinctions
    </div>

    <ul class="list-disc mx-6 space-y-3">

      <li>
        <strong>Marie Skłodowska-Curie Individual Postdoctoral Fellowship</strong>
        — European Union Horizon 2020 (2018–2020)
      </li>

      <li>
        <strong>Biocon-Bristol Myers Squibb Spot Award</strong>
        (2026)
      </li>

      <li>
        <strong>Biocon-Bristol Myers Squibb Bravo Awards</strong>
        (2023, 2024)
      </li>

      <li>
        <strong>CAS Registry® Innovator Certificate</strong>
        for novel chemical substance innovations (2023)
      </li>

      <li>
        <strong>University Silver Medal</strong>
        from Bengal Engineering and Science University, Shibpur (2008)
      </li>

      <li>
        <strong>Senior Research Fellowship</strong>
        from the Council of Scientific and Industrial Research, India
        (2010–2013)
      </li>

      <li>
        <strong>Junior Research Fellowship</strong>
        from the Council of Scientific and Industrial Research, India
        (2008–2010)
      </li>

      <li>
        <strong>GATE</strong> — Qualified Graduate Aptitude Test in Engineering
        (2008)
      </li>

      <li>
        <strong>CSIR-UGC NET</strong> — Qualified National Eligibility Test
        in Chemical Sciences (2007, 2008)
      </li>

    </ul>

  </section>


  <!-- Professional Service -->
  <section class="mb-12">

    <div class="text-2xl w-full font-bold mb-5">
      Professional Service
    </div>

    <ul class="list-disc mx-6 space-y-3">

      <li>
        <strong>Journal Peer Reviewer:</strong>
        Reviewed 71 manuscripts for 23 journals, including
        <i>Angewandte Chemie International Edition</i>,
        <i>Organic Letters</i>, and
        <i>The Journal of Organic Chemistry</i>.
      </li>

    </ul>

  </section>


  <!-- Professional Memberships -->
  <section class="mb-12">

    <div class="text-2xl w-full font-bold mb-5">
      Professional Memberships
    </div>

    <ul class="list-disc mx-6 space-y-3">

      <li>
        <strong>Royal Society of Chemistry</strong>
        — Member since 2019
      </li>

      <li>
        <strong>Indian Chemical Society</strong>
        — Life Member since 2019
      </li>

      <li>
        <strong>Marie Curie Alumni Association</strong>
        — Member since 2018
      </li>

      <li>
        <strong>Chemical Research Society of India</strong>
        — Life Member since 2017
      </li>

      <li>
        <strong>IIT Kanpur Alumni Association</strong>
        — Life Member since 2017
      </li>

    </ul>

  </section>

</BaseLayout>
