---
import MainLayout from "../layouts/MainLayout.astro";
---

<MainLayout title="CV | Dr. Aditya Bhattacharyya">
  <div class="max-w-4xl mx-auto px-4 py-8 space-y-10">
    
    <!-- Header / Top Bar -->
    <div class="flex flex-col md:flex-row justify-between items-start md:items-center border-b pb-6 gap-4">
      <div>
        <h1 class="text-3xl font-bold text-gray-900 dark:text-white">Dr. Aditya Bhattacharyya</h1>
        <p class="text-lg text-gray-600 dark:text-gray-300 font-medium">Associate Scientific Director | Chemical Synthesis</p>
        <p class="text-sm text-gray-500">Biocon Bristol Myers Squibb R&D Center (BBRC), Syngene International Ltd.</p>
      </div>
      <a 
        href="/Bhattacharyya_CV.pdf" 
        target="_blank" 
        class="inline-flex items-center px-4 py-2 border border-transparent text-sm font-medium rounded-md shadow-sm text-white bg-blue-600 hover:bg-blue-700 transition"
      >
        📄 Download PDF CV
      </a>
    </div>

    <!-- Executive Summary -->
    <section>
      <h2 class="text-xl font-semibold text-gray-900 dark:text-white border-b pb-2 mb-4">Executive Summary</h2>
      <p class="text-gray-700 dark:text-gray-300 leading-relaxed">
        Organic & Synthetic Chemist with 6+ years of postdoctoral research experience across Germany and India, combined with 3+ years of pharmaceutical CRO technical leadership[cite: 1]. Marie Skłodowska-Curie Individual Fellow (Score: 95.60%)[cite: 1] with 37 peer-reviewed publications, 2 granted patents, and >1,800 citations[cite: 1]. Specialized in photoredox catalysis, visible-light-driven transformations, and complex small-ring heterocycle synthesis for drug discovery[cite: 1].
      </p>
    </section>

    <!-- Professional Experience -->
    <section>
      <h2 class="text-xl font-semibold text-gray-900 dark:text-white border-b pb-2 mb-4">Professional Experience</h2>
      <div class="space-y-6">
        <div>
          <div class="flex justify-between items-baseline">
            <h3 class="text-lg font-medium text-gray-900 dark:text-white">Associate Scientific Director</h3>
            <span class="text-sm text-gray-500">Aug 2026 – Present</span>
          </div>
          <p class="text-sm text-blue-600 dark:text-blue-400">Department of Chemical Synthesis, BBRC, Syngene International Ltd., India</p>
        </div>

        <div>
          <div class="flex justify-between items-baseline">
            <h3 class="text-lg font-medium text-gray-900 dark:text-white">Principal Investigator (Team Lead)</h3>
            <span class="text-sm text-gray-500">Oct 2024 – Jul 2026</span>
          </div>
          <p class="text-sm text-blue-600 dark:text-blue-400">Department of Chemical Synthesis, BBRC, Syngene International Ltd., India</p>
        </div>

        <div>
          <div class="flex justify-between items-baseline">
            <h3 class="text-lg font-medium text-gray-900 dark:text-white">Senior Research Investigator (Team Lead)</h3>
            <span class="text-sm text-gray-500">Oct 2022 – Sep 2024</span>
          </div>
          <p class="text-sm text-blue-600 dark:text-blue-400">Department of Discovery Synthesis, BBRC, Syngene International Ltd., India</p>
        </div>

        <div>
          <div class="flex justify-between items-baseline">
            <h3 class="text-lg font-medium text-gray-900 dark:text-white">Postdoctoral Researcher & Marie Curie Fellow</h3>
            <span class="text-sm text-gray-500">Apr 2018 – Sept 2022</span>
          </div>
          <p class="text-sm text-blue-600 dark:text-blue-400">Universität Regensburg, Germany (Advisor: Prof. Dr. Oliver Reiser)</p>
          <p class="text-sm text-gray-600 dark:text-gray-400 mt-1">Research focus: Copper photoredox-catalyzed ring-opening transformations of small ring aza-heterocycles and carbacycles[cite: 1].</p>
        </div>

        <div>
          <div class="flex justify-between items-baseline">
            <h3 class="text-lg font-medium text-gray-900 dark:text-white">CSIR Research Associate & DST Project Scientist</h3>
            <span class="text-sm text-gray-500">Jun 2016 – Mar 2018</span>
          </div>
          <p class="text-sm text-blue-600 dark:text-blue-400">IIT Kanpur, India (Advisor: Prof. Manas K. Ghorai)</p>
        </div>
      </div>
    </section>

    <!-- Education -->
    <section>
      <h2 class="text-xl font-semibold text-gray-900 dark:text-white border-b pb-2 mb-4">Education</h2>
      <div class="space-y-4">
        <div>
          <div class="flex justify-between items-baseline">
            <h3 class="text-base font-semibold text-gray-900 dark:text-white">Ph.D. in Organic Chemistry</h3>
            <span class="text-sm text-gray-500">2016</span>
          </div>
          <p class="text-sm text-gray-600 dark:text-gray-400">Indian Institute of Technology (IIT) Kanpur, India</p>
          <p class="text-xs text-gray-500 italic mt-1">Thesis: Ring-Opening Transformations of Activated Aziridines to Iminothiazolidines, Tetrahydropyrimidines, Oxime Amino Ethers, and Morpholines[cite: 1]</p>
        </div>

        <div>
          <div class="flex justify-between items-baseline">
            <h3 class="text-base font-semibold text-gray-900 dark:text-white">M.Sc. in Organic Chemistry</h3>
            <span class="text-sm text-gray-500">2008</span>
          </div>
          <p class="text-sm text-gray-600 dark:text-gray-400">Bengal Engineering and Science University (IIEST Shibpur), India</p>
          <p class="text-xs text-blue-600 dark:text-blue-400 font-medium">Rank: First Class First (University Silver Medalist)[cite: 1]</p>
        </div>

        <div>
          <div class="flex justify-between items-baseline">
            <h3 class="text-base font-semibold text-gray-900 dark:text-white">B.Sc. (Honours) in Chemistry</h3>
            <span class="text-sm text-gray-500">2006</span>
          </div>
          <p class="text-sm text-gray-600 dark:text-gray-400">Bangabasi College, University of Calcutta, India</p>
        </div>
      </div>
    </section>

    <!-- Major Fellowships & Awards -->
    <section>
      <h2 class="text-xl font-semibold text-gray-900 dark:text-white border-b pb-2 mb-4">Honors & Grants</h2>
      <ul class="list-disc list-inside space-y-2 text-sm text-gray-700 dark:text-gray-300">
        <li><strong>Biocon-BMS Spot & Bravo Awards</strong> for productivity in BMS project execution & publication (2023–2026)[cite: 1]</li>
        <li><strong>Marie Skłodowska-Curie Individual Fellowship</strong> (€159,460.80), European Union Horizon 2020 (2018–2020)[cite: 1]</li>
        <li><strong>CAS Registry® Innovator Certificate</strong> for novel chemical substance innovations (2023)[cite: 1]</li>
        <li><strong>GATE Examination:</strong> Score 504, Percentile 98.43, All India Rank 102 (2008)[cite: 1]</li>
        <li><strong>CSIR-UGC NET:</strong> Qualified National Eligibility Test in Chemical Sciences (2007, 2008)[cite: 1]</li>
      </ul>
    </section>

    <!-- Technical & Editorial Roles -->
    <section>
      <h2 class="text-xl font-semibold text-gray-900 dark:text-white border-b pb-2 mb-4">Professional Service & Memberships</h2>
      <ul class="list-disc list-inside space-y-2 text-sm text-gray-700 dark:text-gray-300">
        <li><strong>European Commission Expert Evaluator:</strong> Reviewed 49 Horizon Europe MSCA proposals[cite: 1].</li>
        <li><strong>Slovak Research Agency Evaluator:</strong> Reviewed 6 national RDI project proposals[cite: 1].</li>
        <li><strong>Journal Peer Reviewer:</strong> 71 manuscripts for 23 journals (including <i>Angew. Chem. Int. Ed.</i>, <i>Org. Lett.</i>, <i>J. Org. Chem.</i>)[cite: 1].</li>
        <li><strong>Review Editor:</strong> Editorial Board of Organic Chemistry, <i>Frontiers in Chemistry</i>[cite: 1].</li>
        <li><strong>Memberships:</strong> Royal Society of Chemistry (MRSC)[cite: 1], Fellow of Indian Chemical Society (FICS)[cite: 1], Marie Curie Alumni Association[cite: 1].</li>
      </ul>
    </section>

  </div>
</MainLayout>
