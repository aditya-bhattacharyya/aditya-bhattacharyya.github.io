---
import Layout from "@/layouts/Layout.astro";
import { publications } from "@/data/cv";
import { highlightAuthor } from "@/lib/utils";
import { template } from "@/settings";
import Publication33Graphic from "@/assets/publications/publication-33-scheme.jpg";

const ALL_PAPERS = publications;
---

<Layout title="Publications">

  <div class="max-w-none">

    <!-- Page header -->
    <div class="mb-10">

      <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4">

        <div>

          <p class="text-sm uppercase tracking-wider opacity-60 mb-2">
            Research Output
          </p>

          <h1 class="text-3xl md:text-4xl font-bold">
            Publications
          </h1>

        </div>

        <div class="text-sm opacity-60">
          {ALL_PAPERS.length} publications
        </div>

      </div>

      <div class="mt-5 max-w-3xl">

        <p class="text-base leading-relaxed opacity-70">
          Peer-reviewed research articles, reviews, and book chapters spanning
          synthetic organic chemistry, photoredox catalysis, heterocyclic
          chemistry, and reaction technology.
        </p>

      </div>

    </div>


    <!-- Authorship notation -->
    <div class="mb-6 text-sm text-base-content/60">

      <span class="font-medium text-base-content/80">*</span>
      Corresponding author

      <span class="mx-2 text-base-content/30">·</span>

      <span class="font-medium text-base-content/80">†</span>
      Equal contribution

    </div>


    <!-- Publication list -->
    <div class="space-y-4">

      {ALL_PAPERS.map((paper, index) => {

        const serialNumber = ALL_PAPERS.length - index;

        /*
         * Existing publication references are formatted like:
         *
         * 2026
         * 2025, 367 (15), e9606
         * 2024, 35 (20), 2459–2464
         *
         * Display format:
         *
         * 2025, 367 (15), e9606
         *
         * Year  → bold
         * Volume → italic
         * Issue/pages → normal
         */

        const timeMatch = paper.time.match(
          /^(\d{4})(?:,\s*(\d+)(.*))?$/
        );

        const year = timeMatch?.[1] ?? paper.time;
        const volume = timeMatch?.[2] ?? "";
        const remainingReference = timeMatch?.[3] ?? "";

        /*
         * Publication 33 is the first item because the publication
         * numbers are displayed in reverse chronological order.
         */
        const isPublication33 = index === 0;

        return (

          isPublication33 ? (

            <!-- ========================================================= -->
            <!-- PUBLICATION 33 — FLIP CARD                              -->
            <!-- ========================================================= -->

            <div class="publication-flip-container">

              <article class="publication-flip-card">


                <!-- =================================================== -->
                <!-- FRONT                                               -->
                <!-- =================================================== -->

                <div
                  class="publication-flip-face publication-flip-front
                         group relative rounded-2xl bg-base-200
                         border border-base-300/50
                         hover:border-primary/40 hover:shadow-sm
                         transition-all duration-200"
                >

                  <div class="p-5 md:p-6">

                    <div class="flex gap-4 md:gap-6">

                      <!-- Serial number -->
                      <div class="shrink-0 w-10 md:w-14 pt-1">

                        <div
                          class="text-2xl md:text-3xl font-bold
                                 text-base-content/20
                                 group-hover:text-accent
                                 transition-colors duration-200"
                        >
                          {String(serialNumber).padStart(2, "0")}
                        </div>

                      </div>


                      <!-- Publication content -->
                      <div class="flex-1 min-w-0">


                        <!-- Journal -->
                        <div class="mb-2 leading-relaxed">

                          <span
                            class="text-base md:text-lg
                                   font-semibold
                                   italic
                                   text-secondary"
                          >
                            {paper.journal}
                          </span>

                        </div>


                        <!-- Bibliographic reference -->
                        <div
                          class="mb-3
                                 text-xs md:text-sm
                                 text-base-content/55"
                        >

                          {volume ? (
                            <>
                              <span class="font-bold">{year}</span>{`, `}
                              <span class="italic">{volume}</span>{remainingReference}
                            </>
                          ) : (
                            <span class="font-bold">{year}</span>
                          )}

                        </div>


                        <!-- Title -->
                        <h2
                          class="text-lg md:text-xl
                                 font-semibold
                                 leading-snug"
                        >

                          <a
                            href={template.base + paper.link}
                            class="no-underline
                                   text-base-content
                                   hover:text-accent
                                   transition-colors duration-200"
                          >
                            <span set:html={paper.title} />
                          </a>

                        </h2>


                        <!-- Authors -->
                        <p
                          class="text-sm md:text-base
                                 mt-3
                                 leading-relaxed
                                 text-base-content/70"
                        >

                          <span
                            class="font-medium
                                   text-base-content/90"
                          >
                            Authors:
                          </span>

                          {" "}

                          <span set:html={highlightAuthor(paper.authors)} />

                        </p>


                        <!-- Buttons -->
                        <div
                          class="mt-5 flex flex-wrap
                                 justify-end gap-2"
                        >

                          <!-- Read Paper -->
                          <a
                            href={paper.link}
                            target="_blank"
                            rel="noopener noreferrer"
                            class="inline-flex items-center
                                   rounded-md
                                   px-3 py-1.5
                                   text-xs
                                   font-semibold
                                   bg-accent
                                   text-black
                                   hover:opacity-90
                                   transition-opacity duration-200"
                          >
                            Read Paper
                          </a>


                          <!-- Graphical Abstract -->
                          <button
                            type="button"
                            class="flip-button inline-flex items-center
                                   rounded-md
                                   px-3 py-1.5
                                   text-xs
                                   font-semibold
                                   bg-primary
                                   text-primary-content
                                   hover:opacity-90
                                   transition-opacity duration-200"
                            aria-label="View graphical abstract"
                            data-flip-button
                          >
                            Graphical Abstract
                          </button>

                        </div>

                      </div>

                    </div>

                  </div>

                </div>


                <!-- =================================================== -->
                <!-- BACK                                                -->
                <!-- =================================================== -->

                <div
                  class="publication-flip-face publication-flip-back
                         rounded-2xl bg-base-200
                         border border-base-300/50"
                >

                  <div
                    class="p-4 md:p-5 h-full
                           flex flex-col"
                  >

                    <!-- ================================================= -->
                    <!-- BACK HEADER                                      -->
                    <!-- ================================================= -->

                    <div
                      class="flex items-center
                             justify-between
                             gap-3
                             mb-3"
                    >

                      <!-- Publication number + title -->
                      <div
                        class="flex items-center
                               gap-2
                               min-w-0"
                      >

                        <span
                          class="text-sm
                                 font-semibold
                                 text-base-content/40
                                 shrink-0"
                        >
                          33
                        </span>

                        <span
                          class="text-base-content/30"
                        >
                          ·
                        </span>

                        <span
                          class="text-sm md:text-base
                                 font-semibold
                                 text-base-content/75
                                 whitespace-nowrap"
                        >
                          Graphical Abstract
                        </span>

                      </div>


                      <!-- Back controls -->
                      <div
                        class="flex items-center
                               gap-2
                               shrink-0"
                      >

                        <!-- Read Paper -->
                        <a
                          href={paper.link}
                          target="_blank"
                          rel="noopener noreferrer"
                          class="inline-flex items-center
                                 rounded-md
                                 px-3 py-1.5
                                 text-xs
                                 font-semibold
                                 bg-accent
                                 text-primary-content
                                 hover:opacity-90
                                 transition-opacity duration-200"
                        >
                          Read Paper
                        </a>


                        <!-- Back -->
                        <button
                          type="button"
                          class="flip-button
                                 inline-flex items-center
                                 rounded-md
                                 px-3 py-1.5
                                 text-xs
                                 font-semibold
                                 bg-primary
                                 text-primary-content
                                 hover:opacity-90
                                 transition-opacity duration-200"
                          aria-label="Return to publication details"
                          data-flip-button
                        >
                          Back
                        </button>

                      </div>

                    </div>


                    <!-- ================================================= -->
                    <!-- GRAPHICAL ABSTRACT                               -->
                    <!-- ================================================= -->

                    <div
                      class="graphical-abstract-container
                             flex-1 min-h-0
                             rounded-xl
                             bg-base-100
                             border border-base-300/40
                             overflow-hidden
                             flex items-center justify-center
                             p-2 md:p-3"
                    >

                      <img
                        src={Publication33Graphic.src}
                        alt="Graphical abstract for Publication 33"
                        class="graphical-abstract-image"
                      />

                    </div>

                  </div>

                </div>

              </article>

            </div>

          ) : (

            <!-- ========================================================= -->
            <!-- EXISTING PUBLICATION CARDS — UNCHANGED                   -->
            <!-- ========================================================= -->

            <article
              class="group relative rounded-2xl bg-base-200 border border-base-300/50
                     hover:border-primary/40 hover:shadow-sm
                     transition-all duration-200"
            >

              <div class="p-5 md:p-6">

                <div class="flex gap-4 md:gap-6">

                  <!-- Reverse serial number -->
                  <div class="shrink-0 w-10 md:w-14 pt-1">

                    <div
                      class="text-2xl md:text-3xl font-bold
                             text-base-content/20
                             group-hover:text-accent
                             transition-colors duration-200"
                    >
                      {String(serialNumber).padStart(2, "0")}
                    </div>

                  </div>


                  <!-- Publication content -->
                  <div class="flex-1 min-w-0">


                    <!-- Journal -->
                    <div class="mb-2 leading-relaxed">

                      <span
                        class="text-base md:text-lg
                               font-semibold
                               italic
                               text-secondary"
                      >
                        {paper.journal}
                      </span>

                    </div>


                    <!-- Bibliographic reference -->
                    <div
                      class="mb-3
                             text-xs md:text-sm
                             text-base-content/55"
                    >

                      {volume ? (
                        <>
                          <span class="font-bold">{year}</span>{`, `}
                          <span class="italic">{volume}</span>{remainingReference}
                        </>
                      ) : (
                        <span class="font-bold">{year}</span>
                      )}

                    </div>


                    <!-- Title -->
                    <h2
                      class="text-lg md:text-xl
                             font-semibold
                             leading-snug"
                    >

                      <a
                        href={template.base + paper.link}
                        class="no-underline
                               text-base-content
                               hover:text-accent
                               transition-colors duration-200"
                      >
                        <span set:html={paper.title} />
                      </a>

                    </h2>


                    <!-- Authors -->
                    <p
                      class="text-sm md:text-base
                             mt-3
                             leading-relaxed
                             text-base-content/70"
                    >

                      <span
                        class="font-medium
                               text-base-content/90"
                      >
                        Authors:
                      </span>

                      {" "}

                      <span set:html={highlightAuthor(paper.authors)} />

                    </p>


                    <!-- Read Paper -->
                    <div class="mt-4 flex justify-end">

                      <a
                        href={paper.link}
                        target="_blank"
                        rel="noopener noreferrer"
                        class="inline-flex items-center
                               rounded-md
                               px-3 py-1.5
                               text-xs
                               font-semibold
                               bg-accent
                               text-black
                               hover:opacity-90
                               transition-opacity duration-200"
                      >
                        Read Paper
                      </a>

                    </div>

                  </div>

                </div>

              </div>

            </article>

          )

        );

      })}

    </div>


    <!-- Closing note -->
    <div class="mt-10 pt-6 border-t border-base-300/60">

      <p class="text-sm opacity-50 text-center">
        Graphical abstracts and additional publication details will be added
        progressively.
      </p>

    </div>

  </div>

</Layout>


<!-- ============================================================= -->
<!-- FLIP CARD STYLES                                             -->
<!-- ============================================================= -->

<style>

  /*
   * Establish the 3D perspective.
   */
  .publication-flip-container {
    perspective: 1200px;
  }


  /*
   * The front determines the card height.
   *
   * The back is positioned absolutely and therefore cannot
   * make the publication card taller.
   */
  .publication-flip-card {
    position: relative;
    width: 100%;
    transform-style: preserve-3d;
    transition:
      transform 0.7s cubic-bezier(0.4, 0.2, 0.2, 1);
  }


  /*
   * Both faces occupy the same physical width.
   */
  .publication-flip-face {
    width: 100%;
    backface-visibility: hidden;
    -webkit-backface-visibility: hidden;
  }


  /*
   * FRONT
   *
   * Remains in normal document flow.
   * Therefore it determines the height of the card.
   */
  .publication-flip-front {
    position: relative;
    z-index: 2;
  }


  /*
   * BACK
   *
   * Occupies exactly the same rectangle as the front.
   */
  .publication-flip-back {
    position: absolute;
    inset: 0;
    transform: rotateY(180deg);
    overflow: hidden;
  }


  /*
   * Rotate the card when flipped.
   */
  .publication-flip-card.is-flipped {
    transform: rotateY(180deg);
  }


  /*
   * Graphical abstract container.
   */
  .graphical-abstract-container {
    position: relative;
  }


  /*
   * Keep the chemical scheme proportional.
   *
   * contain = no distortion and no additional cropping.
   */
  .graphical-abstract-image {
    display: block;
    width: 100%;
    height: 100%;
    object-fit: contain;
    object-position: center;
  }


  /*
   * Respect reduced-motion accessibility settings.
   */
  @media (prefers-reduced-motion: reduce) {

    .publication-flip-card {
      transition: none;
    }

  }


  /*
   * Mobile layout.
   *
   * The controls can wrap if the screen becomes too narrow,
   * while retaining their normal button size.
   */
  @media (max-width: 767px) {

    .publication-flip-back > div > div:first-child {
      flex-wrap: wrap;
    }

  }

</style>


<!-- ============================================================= -->
<!-- FLIP CARD INTERACTION                                        -->
<!-- ============================================================= -->

<script>

  document.addEventListener("click", (event) => {

    const target = event.target as HTMLElement | null;

    const button = target?.closest("[data-flip-button]");

    if (!button) return;

    const card = button.closest(".publication-flip-card");

    if (!card) return;

    card.classList.toggle("is-flipped");

  });

</script>
