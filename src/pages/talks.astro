---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Invited Talks | Dr. Aditya Bhattacharyya">

  <div class="max-w-none">

    <p class="text-sm uppercase tracking-wider opacity-60 mb-2">
      Presentations & Professional Engagement
    </p>

    <h1 class="text-3xl md:text-4xl font-bold mb-10">
      Invited Talks
    </h1>


    <!-- Research Talks -->
    <section class="mb-12">

      <h2 class="text-2xl font-bold mb-4">
        Research Talks
      </h2>

      <p class="opacity-70">
        Selected research presentations and invited scientific talks.
      </p>

    </section>


    <!-- Poster Presentations -->
    <section class="mb-12">

      <h2 class="text-2xl font-bold mb-4">
        Poster Presentations
      </h2>

      <p class="opacity-70">
        Selected poster presentations at scientific conferences and symposia.
      </p>

    </section>


    <!-- Career Development Talks -->
    <section class="mb-12">

      <h2 class="text-2xl font-bold mb-4">
        Career Development Talks
      </h2>

      <p class="opacity-70">
        Talks and professional-development activities related to academic,
        industrial, and scientific careers.
      </p>

    </section>

  </div>

</Layout>
