---

<Layout title="Invited Talks | Dr. Aditya Bhattacharyya">

  <div class="max-w-none">

    <!-- Page introduction -->
    <div class="mb-12">
      <p class="text-sm uppercase tracking-wider opacity-60 mb-2">
        Presentations & Professional Engagement
      </p>

      <h1 class="text-3xl md:text-4xl font-bold mb-4">
        Invited Talks & Presentations
      </h1>

      <p class="max-w-3xl text-base leading-relaxed opacity-70">
        Selected research talks, conference presentations, and
        career-development engagements spanning academic research,
        pharmaceutical science, and the transition from academia to industry.
      </p>
    </div>


    <!-- ========================================================= -->
    <!-- RESEARCH TALKS -->
    <!-- ========================================================= -->

    <section class="mb-16">

      <div class="flex items-end justify-between gap-4 mb-7">
        <div>
          <p class="text-xs uppercase tracking-widest opacity-50 mb-1">
            Scientific Presentations
          </p>

          <h2 class="text-2xl md:text-3xl font-bold">
            Research Talks
          </h2>
        </div>

        <div class="text-sm opacity-50 hidden sm:block">
          {researchTalks.length} presentations
        </div>
      </div>


      <div class="space-y-4">

        {researchTalks.map((talk) => (
          <article
            class="card bg-base-200 border border-base-300/50 hover:border-base-content/20 transition-colors"
          >
            <div class="card-body p-5 md:p-6">

              <div class="flex flex-col md:flex-row md:items-start gap-4">

                <!-- Date -->
                <div class="md:w-28 shrink-0">
                  <div class="text-sm font-semibold opacity-60">
                    {talk.date}
                  </div>
                </div>


                <!-- Main information -->
                <div class="flex-1 min-w-0">

                  <h3 class="text-base md:text-lg font-semibold leading-snug">
                    {talk.event}
                  </h3>

                  <p class="mt-2 text-sm opacity-65">
                    {talk.location}
                  </p>

                </div>


                <!-- Presentation mode -->
                <div class="shrink-0">

                  {talk.mode === "In-person" ? (
                    <span class="badge badge-primary badge-outline whitespace-nowrap">
                      In-person
                    </span>
                  ) : (
                    <span class="badge badge-secondary badge-outline whitespace-nowrap">
                      Virtual
                    </span>
                  )}

                </div>

              </div>

            </div>
          </article>
        ))}

      </div>

    </section>


    <!-- ========================================================= -->
    <!-- POSTER PRESENTATIONS -->
    <!-- ========================================================= -->

    <section class="mb-16">

      <div class="flex items-end justify-between gap-4 mb-7">
        <div>
          <p class="text-xs uppercase tracking-widest opacity-50 mb-1">
            Conference Contributions
          </p>

          <h2 class="text-2xl md:text-3xl font-bold">
            Poster Presentations
          </h2>
        </div>

        <div class="text-sm opacity-50 hidden sm:block">
          {posterPresentations.length} presentations
        </div>
      </div>


      <div class="grid grid-cols-1 md:grid-cols-2 gap-4">

        {posterPresentations.map((poster) => (
          <article
            class="card bg-base-200 border border-base-300/50 hover:border-base-content/20 transition-colors"
          >
            <div class="card-body p-5">

              <div class="flex items-start justify-between gap-3 mb-3">

                <span class="text-sm font-semibold opacity-60">
                  {poster.date}
                </span>

                <span class="badge badge-accent badge-outline whitespace-nowrap">
                  {poster.type}
                </span>

              </div>

              <h3 class="font-semibold leading-snug">
                {poster.event}
              </h3>

              <p class="text-sm opacity-60 mt-2">
                {poster.location}
              </p>

            </div>
          </article>
        ))}

      </div>

    </section>


    <!-- ========================================================= -->
    <!-- CAREER DEVELOPMENT TALKS -->
    <!-- ========================================================= -->

    <section class="mb-12">

      <div class="mb-7">

        <p class="text-xs uppercase tracking-widest opacity-50 mb-1">
          Professional Development
        </p>

        <h2 class="text-2xl md:text-3xl font-bold">
          Career Development Talks
        </h2>

      </div>


      <div class="grid grid-cols-1 md:grid-cols-2 gap-5">

        {careerTalks.map((talk) => (
          <article
            class="card bg-base-200 border border-base-300/50 hover:border-base-content/20 transition-colors"
          >
            <div class="card-body p-6">

              <div class="flex items-center justify-between gap-3 mb-5">

                <span class="text-sm font-semibold opacity-60">
                  {talk.date}
                </span>

                <span class="badge badge-secondary badge-outline whitespace-nowrap">
                  {talk.mode}
                </span>

              </div>

              <h3 class="text-lg font-semibold leading-snug">
                {talk.event}
              </h3>

              <p class="text-sm opacity-60 mt-3">
                {talk.host}
              </p>

              {talk.link && (
                <div class="mt-5">

                  <a
                    href={talk.link}
                    target="_blank"
                    rel="noopener noreferrer"
                    class="link link-primary text-sm font-medium no-underline hover:underline"
                  >
                    View recorded session ↗
                  </a>

                </div>
              )}

            </div>
          </article>
        ))}

      </div>

    </section>

  </div>

</Layout>
