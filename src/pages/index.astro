    <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">

      <div>
        <div class="text-3xl font-bold">
          33
        </div>

        <div class="text-sm opacity-70 mt-1">
          Publications
        </div>
      </div>


      <div>
        <div class="text-3xl font-bold">
          1,900+
        </div>

        <div class="text-sm opacity-70 mt-1">
          Citations
        </div>
      </div>


      <div>
        <div class="text-3xl font-bold">
          18
        </div>

        <div class="text-sm opacity-70 mt-1">
          h-index
        </div>
      </div>


      <div>
        <div class="text-3xl font-bold">
          2
        </div>

        <div class="text-sm opacity-70 mt-1">
          Granted patents
        </div>
      </div>

    </div>

  </section>


  <!-- ========================================================= -->
  <!-- RESEARCH & SCIENTIFIC EXPERTISE -->
  <!-- ========================================================= -->
