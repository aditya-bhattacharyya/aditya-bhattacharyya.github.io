---
import Layout from "../layouts/Layout.astro";
import { publications } from "@/data/cv";
import ProfilePictures from "@/assets/profile.png";

const selectedPublications = [
  publications[1],  // Advanced Synthesis & Catalysis, 2025
  publications[5],  // Organic Letters, 2024
  publications[8],  // Angewandte Chemie International Edition, 2021
  publications[14], // Science, 2019
  publications[16], // Organic Letters, 2018
];

/*
 * Format publication citation:
 *
 * 2026, 30 (15), 1047–1060
 * └── year bold
 *       └── volume italic
 *
 * Other information such as issue and page numbers remains normal.
 */
function formatCitation(time: string): string {
  if (!time) return "";

  const match = time.match(/^(\d{4}),\s*(.*)$/);

  if (!match) {
    return time;
  }

  const year = match[1];
  const rest = match[2];

  /*
   * Standard journal format:
   * 2026, 30 (15), 1047–1060
   */
  const standardMatch = rest.match(
    /^(\d+(?:\.\d+)?)(.*)$/
  );

  if (!standardMatch) {
    return `<strong>${year}</strong>, ${rest}`;
  }

  const volume = standardMatch[1];
  const remaining = standardMatch[2];

  return `<strong>${year}</strong>, <em>${volume}</em>${remaining}`;
}
---

<Layout title="Dr. Aditya Bhattacharyya | Synthetic Organic Chemist">

  <!-- ========================================================= -->
  <!-- HERO SECTION -->
  <!-- ========================================================= -->
  <section class="py-8 md:py-14">

    <div class="grid md:grid-cols-[1fr_auto] gap-8 md:gap-12 items-start">

      <!-- Hero Text -->
