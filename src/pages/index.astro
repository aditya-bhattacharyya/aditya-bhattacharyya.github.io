            Synthetic chemistry supporting advanced antibody–drug conjugate
            programs and emerging bioconjugation-based therapeutics.
          </p>

        </div>

      </div>

    </div>

  </section>


  <!-- ========================================================= -->
  <!-- SELECTED PUBLICATIONS -->
  <!-- ========================================================= -->
  <section class="py-12 border-t">

    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4 mb-8">

      <div>

        <p class="text-sm uppercase tracking-wider opacity-60 mb-2">
          Selected Work
        </p>

        <h2 class="text-3xl font-bold">
          Selected Publications
        </h2>

      </div>


      <a
        href="/papers"
        class="text-sm font-medium hover:text-accent transition-colors"
      >
        View all publications →
      </a>

    </div>


    <p class="text-base md:text-lg leading-relaxed opacity-70 max-w-4xl mb-8">
      Selected publications highlighting my contributions to photoredox
      catalysis, synthetic methodology, and pharmaceutical chemistry.
    </p>


    <div class="space-y-6">

      {selectedPublications.map((paper, index) => (

        <article class="border-b pb-6">

          <div class="flex gap-4">

            <!-- Publication Number -->
            <div class="text-sm opacity-50 pt-1 shrink-0 w-5">
              {index + 1}
            </div>


            <div class="min-w-0">

              <!-- Publication Title -->
              <h3 class="text-lg font-semibold leading-snug mb-2">

                <a
                  href={paper.link}
                  target="_blank"
                  rel="noopener noreferrer"
                  class="hover:text-primary transition-colors"
                >
                  <span set:html={paper.title} />
                </a>

              </h3>


              <!-- Authors -->
              <p class="text-sm leading-relaxed mb-2">
                <span set:html={paper.authors} />
              </p>


              <!-- Journal -->
              <p class="text-sm opacity-70">

                <span class="italic">
                  {paper.journal}
                </span>

              </p>


              <!-- Citation -->
              <p
                class="text-sm opacity-70 mt-1"
                set:html={formatCitation(paper.time)}
              />

            </div>

          </div>

        </article>

      ))}

    </div>


    <div class="mt-8">

      <a
        href="/papers"
        class="btn btn-outline"
      >
        Browse all publications
      </a>

    </div>

  </section>


  <!-- ========================================================= -->
  <!-- FINAL CALL TO ACTION -->
  <!-- ========================================================= -->
  <section class="py-12 border-t">

    <div class="card bg-base-200">

      <div
        class="card-body md:flex-row md:items-center
               md:justify-between gap-6"
      >

        <div>

          <h2 class="text-2xl font-bold mb-2">
            Explore my academic and professional work
          </h2>

          <p class="opacity-70">
            Research interests, publications, professional experience,
            and curriculum vitae.
          </p>

        </div>


        <div class="flex flex-wrap gap-3 shrink-0">

          <a
            href="/cv"
            class="btn btn-outline"
          >
            View CV
          </a>

          <a
            href="/papers"
            class="btn btn-outline"
          >
            Publications
          </a>

        </div>

      </div>

    </div>

  </section>

</Layout>
