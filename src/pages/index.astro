---
import Layout from "../layouts/Layout.astro";
import { publications } from "@/data/cv";
import ProfilePictures from "@/assets/profile.png";

const recentPublications = publications.slice(0, 5);
---

<Layout title="Dr. Aditya Bhattacharyya | Synthetic Organic Chemist">

  <!-- ========================================================= -->
  <!-- HERO SECTION -->
  <!-- ========================================================= -->
  <section class="py-8 md:py-14">
    <div class="grid md:grid-cols-[1fr_auto] gap-8 md:gap-12 items-start">

      <!-- Hero Text -->
      <div class="max-w-3xl">

        <p class="text-sm font-medium uppercase tracking-wider opacity-60 mb-3">
          Synthetic Chemistry · Photoredox Catalysis · Drug Discovery · ADC Research
        </p>

        <h1 class="text-4xl md:text-5xl font-bold leading-tight mb-4">
          Dr. Aditya Bhattacharyya
        </h1>

        <h2 class="text-xl md:text-2xl font-medium mb-2">
          Associate Scientific Director | Chemical Synthesis
        </h2>

        <p class="text-base opacity-70 mb-6">
          Biocon Bristol Myers Squibb R&amp;D Center (BBRC),
          Syngene International Ltd.
        </p>

        <p class="text-lg leading-relaxed max-w-3xl mb-8">
          Synthetic organic chemist with multidisciplinary research and
          industrial experience spanning synthetic methodology, small-ring
          heterocycle chemistry, photoredox catalysis, pharmaceutical drug
          discovery, and advanced antibody–drug conjugate (ADC) research.
          My work connects fundamental reaction development with the practical
          synthesis of complex molecules for pharmaceutical research.
        </p>

        <div class="flex flex-wrap gap-3">
          <a href="/research" class="btn btn-outline">
            Research
          </a>

          <a href="/papers" class="btn btn-outline">
            Publications
          </a>

          <a href="/cv" class="btn btn-outline">
            Curriculum Vitae
          </a>
        </div>

      </div>

      <!-- Hero Photo -->
      <div class="flex justify-center md:justify-end items-start pt-2 md:pt-1">

        <div class="avatar">
          <div
            class="w-48 md:w-56 aspect-square rounded-full
                   ring ring-base-300 ring-offset-base-100
                   ring-offset-4 overflow-hidden"
          >
            <img
              src={ProfilePictures.src}
              alt="Dr. Aditya Bhattacharyya"
              class="w-full h-full object-cover object-[50%_32%]"
            />
          </div>
        </div>

      </div>

    </div>
  </section>


  <!-- ========================================================= -->
  <!-- CAREER METRICS -->
  <!-- ========================================================= -->
  <section class="border-y py-8 my-6">

    <div class="grid grid-cols-2 md:grid-cols-4 gap-6 text-center">

      <div>
        <div class="text-3xl font-bold">
          33
        </div>
        <div class="text-sm opacity-70 mt-1">
          Publications
        </div>
      </div>

      <div>
        <div class="text-3xl font-bold">
          1,800+
        </div>
        <div class="text-sm opacity-70 mt-1">
          Citations
        </div>
      </div>

      <div>
        <div class="text-3xl font-bold">
          18
        </div>
        <div class="text-sm opacity-70 mt-1">
          h-index
        </div>
      </div>

      <div>
        <div class="text-3xl font-bold">
          2
        </div>
        <div class="text-sm opacity-70 mt-1">
          Granted patents
        </div>
      </div>

    </div>

  </section>


  <!-- ========================================================= -->
  <!-- RESEARCH & SCIENTIFIC EXPERTISE -->
  <!-- ========================================================= -->
  <section class="py-12">

    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4 mb-8">

      <div>
        <p class="text-sm uppercase tracking-wider opacity-60 mb-2">
          Research &amp; Expertise
        </p>

        <h2 class="text-3xl font-bold">
          Research &amp; Scientific Expertise
        </h2>
      </div>

      <a
        href="/research"
        class="text-sm font-medium hover:text-accent transition-colors"
      >
        View research →
      </a>

    </div>

    <p class="text-lg leading-relaxed opacity-75 max-w-4xl mb-8">
      My work spans fundamental synthetic chemistry and modern pharmaceutical
      research, from photoredox reaction development to drug discovery and
      advanced ADC chemistry.
    </p>


    <!-- Expertise Cards -->
    <div class="grid md:grid-cols-2 gap-6">


    <!-- Card 01 -->
      <div class="card bg-base-200">

        <div class="card-body">

          <div class="text-sm font-bold text-primary mb-3">
            02
          </div>

          <h3 class="card-title text-xl">
            Synthetic &amp; Heterocyclic Chemistry
          </h3>

          <p class="leading-relaxed opacity-75">
            Synthetic methodology, small-ring heterocycles, ring-opening
            chemistry, and complex-molecule synthesis.
          </p>

        </div>

      </div>
      <!-- Card 02 -->
      <div class="card bg-base-200">

        <div class="card-body">

          <div class="text-sm font-bold text-primary mb-3">
            01
          </div>

          <h3 class="card-title text-xl">
            Photoredox Catalysis
          </h3>

          <p class="leading-relaxed opacity-75">
            Visible-light-driven synthesis, radical chemistry, and
            earth-abundant metal photoredox catalysis.
          </p>

        </div>

      </div>


      <!-- Card 03 -->
      <div class="card bg-base-200">

        <div class="card-body">

          <div class="text-sm font-bold text-primary mb-3">
            03
          </div>

          <h3 class="card-title text-xl">
            Drug Discovery
          </h3>

          <p class="leading-relaxed opacity-75">
            Synthetic chemistry for pharmaceutical discovery, including
            analogue synthesis, route development, and challenging
            molecular transformations.
          </p>

        </div>

      </div>


      <!-- Card 04 -->
      <div class="card bg-base-200">

        <div class="card-body">

          <div class="text-sm font-bold text-primary mb-3">
            04
          </div>

          <h3 class="card-title text-xl">
            ADC Chemistry
          </h3>

          <p class="leading-relaxed opacity-75">
            Synthetic chemistry supporting advanced antibody–drug conjugate
            programs and emerging bioconjugation-based therapeutics.
          </p>

        </div>

      </div>

    </div>

  </section>


  <!-- ========================================================= -->
  <!-- RECENT PUBLICATIONS -->
  <!-- ========================================================= -->
  <section class="py-12 border-t">

    <div class="flex flex-col md:flex-row md:items-end md:justify-between gap-4 mb-8">

      <div>
        <p class="text-sm uppercase tracking-wider opacity-60 mb-2">
          Selected Work
        </p>

        <h2 class="text-3xl font-bold">
          Recent Publications
        </h2>
      </div>

      <a
        href="/papers"
        class="text-sm font-medium hover:text-accent transition-colors"
      >
        View all publications →
      </a>

    </div>


    <div class="space-y-6">

      {recentPublications.map((paper, index) => (

        <article class="border-b pb-6">

          <div class="flex gap-4">

            <div class="text-sm opacity-50 pt-1 shrink-0">
              {index + 1}
            </div>

            <div class="min-w-0">

              <h3 class="text-lg font-semibold leading-snug mb-2">
                {paper.title}
              </h3>

              <p class="text-sm leading-relaxed mb-2">
                {paper.authors}
              </p>

              <p class="text-sm opacity-70">

                <span class="italic">
                  {paper.journal}
                </span>

                {paper.time && ` · ${paper.time}`}

              </p>

            </div>

          </div>

        </article>

      ))}

    </div>


    <div class="mt-8">

      <a
        href="/papers"
        class="btn btn-outline"
      >
        Browse all publications
      </a>

    </div>

  </section>


  <!-- ========================================================= -->
  <!-- FINAL CALL TO ACTION -->
  <!-- ========================================================= -->
  <section class="py-12 border-t">

    <div class="card bg-base-200">

      <div
        class="card-body md:flex-row md:items-center
               md:justify-between gap-6"
      >

        <div>

          <h2 class="text-2xl font-bold mb-2">
            Explore my academic and professional work
          </h2>

          <p class="opacity-70">
            Research interests, publications, professional experience,
            and curriculum vitae.
          </p>

        </div>


        <div class="flex flex-wrap gap-3 shrink-0">

          <a
            href="/cv"
            class="btn btn-primary"
          >
            View CV
          </a>

          <a
            href="/papers"
            class="btn btn-outline"
          >
            Publications
          </a>

        </div>

      </div>

    </div>

  </section>

</Layout>
