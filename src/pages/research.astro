---
import Layout from "../layouts/Layout.astro";
---

<Layout title="Research | Dr. Aditya Bhattacharyya">

  <div class="max-w-none">

    <!-- ========================================================= -->
    <!-- RESEARCH INTRODUCTION -->
    <!-- ========================================================= -->
    <section class="mb-12">

      <p class="text-sm uppercase tracking-wider opacity-60 mb-2">
        Scientific Profile
      </p>

      <h1 class="text-3xl md:text-4xl font-bold mb-6">
        Research
      </h1>

      <div class="max-w-4xl">

        <p class="text-lg leading-relaxed mb-5">
          My research lies at the interface of synthetic organic chemistry,
          photochemistry, and pharmaceutical research, with a focus on
          developing practical and efficient methods for the synthesis of
          structurally complex molecules.
        </p>

        <p class="text-lg leading-relaxed">
          My scientific work spans fundamental synthetic chemistry and
          reaction development, visible-light photochemistry and photoredox
          catalysis, pharmaceutical drug discovery, and advanced
          antibody–drug conjugate (ADC) research.
        </p>

      </div>

    </section>


    <!-- ========================================================= -->
    <!-- SCIENTIFIC EXPERTISE -->
    <!-- ========================================================= -->
    <section class="border-t pt-12 mb-12">

      <div class="mb-8">

        <p class="text-sm uppercase tracking-wider opacity-60 mb-2">
          Areas of Expertise
        </p>

        <h2 class="text-3xl font-bold mb-4">
          Scientific Expertise
        </h2>

        <p class="text-lg leading-relaxed opacity-75 max-w-4xl">
          My research combines fundamental reaction chemistry with practical
          synthetic applications across academic and pharmaceutical research.
        </p>

      </div>


      <!-- ======================================================= -->
      <!-- FOUR RESEARCH AREAS -->
      <!-- ======================================================= -->
      <div class="grid md:grid-cols-2 gap-6">

        <!-- 01. Synthetic Organic Chemistry -->
        <div class="card bg-base-200">

          <div class="card-body">

            <h3 class="card-title text-xl">
              Synthetic Organic Chemistry &amp; Ring-Opening Chemistry
            </h3>

            <p class="leading-relaxed">
              Synthetic organic chemistry focused on strained small-ring
              aza-heterocycles and carbacycles, including their activation,
              ring opening, and functionalization for the synthesis of
              structurally complex molecules.
            </p>

          </div>

        </div>


        <!-- 02. Photoredox Catalysis -->
        <div class="card bg-base-200">

          <div class="card-body">

            <h3 class="card-title text-xl">
              Visible-Light Photoredox Catalysis
            </h3>

            <p class="leading-relaxed">
              Visible-light-driven synthetic transformations, with a focus on
              earth-abundant metal-based photoredox catalysis, radical
              chemistry, and new approaches to molecular construction.
            </p>

          </div>

        </div>


        <!-- 03. Drug Discovery -->
        <div class="card bg-base-200">

          <div class="card-body">

            <h3 class="card-title text-xl">
              Drug Discovery &amp; Reaction Development
            </h3>

            <p class="leading-relaxed">
              Synthetic support for pharmaceutical drug discovery, including
              reaction discovery and development, analogue synthesis, route
              development, and practical solutions to challenging chemical
              problems.
            </p>

          </div>

        </div>


        <!-- 04. ADC Research -->
        <div class="card bg-base-200">

          <div class="card-body">

            <h3 class="card-title text-xl">
              ADC Research &amp; Bioconjugation
            </h3>

            <p class="leading-relaxed">
              Synthetic chemistry supporting advanced antibody–drug conjugate
              (ADC) research, extending expertise in reaction development and
              molecular synthesis into emerging bioconjugation-based
              therapeutic platforms.
            </p>

          </div>

        </div>

      </div>

    </section>


    <!-- ========================================================= -->
    <!-- RESEARCH PHILOSOPHY -->
    <!-- ========================================================= -->
    <section class="border-t pt-12">

      <div class="max-w-4xl">

        <p class="text-sm uppercase tracking-wider opacity-60 mb-2">
          Research Philosophy
        </p>

        <h2 class="text-3xl font-bold mb-6">
          Fundamental Chemistry with Real-World Utility
        </h2>

        <p class="text-lg leading-relaxed">
          I believe that impactful synthetic chemistry lies at the
          intersection of fundamental mechanistic understanding and
          real-world utility. My approach aims to transform intricate
          radical and catalytic mechanisms into reliable, scalable synthetic
          technologies that empower drug discovery and solve complex
          structural challenges in organic synthesis.
        </p>

      </div>

    </section>

  </div>

</Layout>
